{
  "name": "prism-bastion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An offline tower defense game.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "desktop:build": "node scripts/build-desktop.mjs build",
    "desktop:dev": "node scripts/build-desktop.mjs dev",
    "desktop:pack": "node scripts/build-desktop.mjs pack",
    "desktop:test": "node --test desktop/*.test.cjs",
    "content:validate": "tsx desktop/validate-content.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "main": "dist/desktop/main.cjs"
}
